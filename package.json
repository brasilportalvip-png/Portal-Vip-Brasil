{
  "name": "froc-ia-platform",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "cross-env NODE_ENV\u003dtest tsx --test test/*.test.ts",
    "prebuild": "npm run typecheck",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform\u003dnode --format\u003dcjs --packages\u003dexternal --sourcemap --outfile\u003d.server/server.cjs",
    "build": "npm run build:client \u0026\u0026 npm run build:server",
    "postbuild": "node --check .server/server.cjs",
    "check": "npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build:client \u0026\u0026 npm run build:server \u0026\u0026 node --check .server/server.cjs",
    "start": "cross-env NODE_ENV\u003dproduction node .server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs\u003drequire(\u0027node:fs\u0027);for(const path of [\u0027dist\u0027,\u0027.server\u0027])fs.rmSync(path,{recursive:true,force:true})\"",
    "cap:sync": "npx cap sync",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@google/genai": "^2.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
